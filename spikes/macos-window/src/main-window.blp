using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  default-width: 1200;
  default-height: 700;
  width-request: 360;
  height-request: 360;
  title: _("Stamped");

  Adw.Breakpoint {
    condition ("max-width: 1100px")

    setters {
      outerSplit.collapsed: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 600px")

    setters {
      outerSplit.collapsed: true;
      innerSplit.collapsed: true;
    }
  }

  content: Adw.OverlaySplitView outerSplit {
    sidebar-width-fraction: 0.2;
    min-sidebar-width: 200;

    sidebar: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle {
          title: _("Mailboxes");
        };
      }

      content: Gtk.ListBox folderList {
        styles ["navigation-sidebar"]
      };
    };

    content: Adw.NavigationSplitView innerSplit {
      min-sidebar-width: 260;
      max-sidebar-width: 420;
      sidebar-width-fraction: 0.35;

      sidebar: Adw.NavigationPage {
        title: _("Conversations");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Gtk.ToggleButton sidebarToggle {
              icon-name: "sidebar-show-symbolic";
              tooltip-text: _("Show mailboxes");
            }
          }

          content: Gtk.ScrolledWindow {
            child: Gtk.ListBox messageList {
              styles ["navigation-sidebar"]
            };
          };
        };
      };

      content: Adw.NavigationPage {
        title: _("Message");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Gtk.ScrolledWindow {
            child: Gtk.Label reader {
              wrap: true;
              xalign: 0;
              yalign: 0;
              margin-top: 18;
              margin-bottom: 18;
              margin-start: 18;
              margin-end: 18;
              label: _("Select a conversation");
            };
          };
        };
      };
    };
  };
}
