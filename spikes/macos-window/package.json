{
    "name": "@stamped/spike-macos-window",
    "description": "Spike: three-pane responsive libadwaita window on gjsify, Linux and macOS.",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjs && gjsify run build:node",
        "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/index.gjs.js",
        "build:node": "gjsify build src/index.ts --app node --outfile dist/index.node.mjs",
        "start": "gjsify run dist/index.gjs.js",
        "start:node": "gjsify run dist/index.node.mjs --runtime node"
    },
    "devDependencies": {
        "@girs/adw-1": "5.4.0",
        "@girs/gio-2.0": "5.4.0",
        "@girs/gjs": "5.4.0",
        "@girs/gobject-2.0": "5.4.0",
        "@girs/gtk-4.0": "5.4.0",
        "@gjsify/cli": "^0.64.2",
        "@gjsify/rolldown-native": "^0.64.2",
        "@gjsify/vite-plugin-blueprint": "^0.64.2",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@gjsify/node-gi": "^0.64.2"
    },
    "gjsify": {
        "main": "dist/index.gjs.js",
        "app": "gjs",
        "ship": {
            "bundle": "dist/index.node.mjs",
            "app": {
                "darwin": "node"
            },
            "appId": "org.correctiv.StampedSpike",
            "maintainer": "Stamped contributors <stamped@example.org>",
            "icon": "data/icons/hicolor/scalable/apps/org.correctiv.StampedSpike.svg",
            "developer": {
                "id": "org.correctiv",
                "name": "CORRECTIV"
            },
            "summary": "Spike for a three-pane mail window",
            "description": "Throwaway spike: responsive libadwaita window on gjsify.",
            "homepageUrl": "https://github.com/correctiv/stamped"
        }
    },
    "license": "AGPL-3.0-only"
}
