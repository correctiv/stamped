# Dependencies
node_modules/

# Build output
dist/

# gjsify
.gjsify/
ship/

# gjsify's local config file. The release writes the embedding model's ship entries into it, so
# the 296 MiB file lands in the AppImage and the macOS .app and in no other artifact.
app/.gjsifyrc.json

# The embedding model: fetched at a PINNED revision by app/scripts/fetch-model.mts and verified
# against its sha256 there — never committed. The licence and the NOTICE beside it ARE committed,
# because redistributing an Apache-2.0 work carries its licence with it.
app/models/*.gguf

# npm is not the package manager here — `gjsify install` is (see AGENTS.md).
package-lock.json

# ─── Case data — NEVER commit ─────────────────────────────────────────────
# Stamped exists to work on leaked mail. A single committed message can burn a
# source, so the repo holds NOTHING but synthetic fixtures that this repo's own
# generator produced (tools/make-fixtures.mjs). Defence in depth only: the real
# guarantee is that nothing is ever WRITTEN here — case folders live outside the
# repo, under $XDG_DATA_HOME/stamped/ or wherever the operator points them.
#
# The two exceptions are the fixture trees, which are generated, reviewed and
# committed on purpose.
#
# A LEAKED ARCHIVE IS A FOLDER, and the tree is read from wherever the operator
# points Stamped at it. The mail in it is covered by the rules below; the rest
# of it — a README, a licence, a spreadsheet — is not mail and must not end up
# here either, so a case folder's own bookkeeping is refused as well.
*.eml
*.mbox
*.pst
*.msg
!app/tests/fixtures/**/*.eml
!app/tests/fixtures/archives/**/*.mbox
cases/
stamped-data/
import-log.jsonl
case.json

# Private keys. The fixture keys are generated and MUST stay out of git even
# though they sign nothing real — a committed private key is a bad habit that
# outlives the fixture it was made for. Only the public halves are committed.
*.key
*.pem
!app/tests/fixtures/keys/*.pub.pem

# Index / derived state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*

# Secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.log
