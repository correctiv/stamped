{
  "useTabs": false,
  "tabWidth": 4,
  "printWidth": 110,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/node_modules",
    "**/dist",
    "**/lib",
    "**/coverage",
    "**/*.gjs.mjs",
    "**/*.node.mjs"
  ]
}
