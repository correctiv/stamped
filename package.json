{
  "name": "stamped",
  "version": "0.3.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Stamped verifies DKIM signatures and explores email archives locally, for journalists. A TypeScript monorepo that runs on GJS via gjsify.",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "check": "gjsify foreach -A check",
    "build": "gjsify workspace stamped-cli build",
    "start": "gjsify workspace stamped-cli start",
    "test": "gjsify workspace stamped-cli test",
    "lint": "gjsify lint .",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "fixtures": "node tools/make-fixtures.mjs",
    "i18n:extract": "./dev/i18n.sh extract",
    "i18n:compile": "./dev/i18n.sh compile"
  },
  "gjsify": {
    "site": {
      "metainfo": "data/org.correctiv.Stamped.metainfo.xml",
      "base": "/stamped/",
      "url": "https://correctiv.github.io/stamped/",
      "languages": [
        "en",
        "de"
      ],
      "defaultLanguage": "en",
      "repository": "correctiv/stamped",
      "icon": "data/icons/hicolor/scalable/apps/org.correctiv.Stamped.svg",
      "releaseAssets": true,
      "pageTranslations": "site/po"
    }
  },
  "devDependencies": {
    "@gjsify/cli": "0.64.12",
    "@gjsify/site": "0.64.12"
  }
}
