msgstr ""
"Der Fallordner {path} wurde von einer neueren Version von Stamped "
"geschrieben."

#: packages/store/src/importer.ts:301
msgid "{path} holds no messages."
msgstr "{path} enthält keine Nachrichten."

#: packages/store/src/importer.ts:404
msgid "{path} holds no mail files."
msgstr "{path} enthält keine Mail-Dateien."

#: packages/store/src/index-db.ts:79
