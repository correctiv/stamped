msgstr "ein Steuerzeichen im Pfad"

#: packages/store/src/zip-store.ts:393
msgid "a directory entry"
msgstr "ein Ordnereintrag"

#: packages/store/src/zip-store.ts:395
msgid "a path that leaves the case folder"
msgstr "ein Pfad, der den Fallordner verlässt"

#: packages/store/src/zip-store.ts:442
msgid "This is not a case file: no ZIP end record was found."
msgstr "Das ist keine Falldatei: Es wurde kein ZIP-Endeintrag gefunden."

#: packages/store/src/zip-store.ts:453 packages/store/src/zip-store.ts:456
msgid "The ZIP64 end record is missing."
msgstr "Der ZIP64-Endeintrag fehlt."

#: packages/store/src/zip-store.ts:461
msgid "The ZIP64 end record is damaged."
msgstr "Der ZIP64-Endeintrag ist beschädigt."

#: packages/store/src/zip-store.ts:469
msgid "The central directory does not end where the end record says."
msgstr ""
"Das zentrale Verzeichnis endet nicht dort, wo der Endeintrag es angibt."

#: packages/store/src/zip-store.ts:487 packages/store/src/zip-store.ts:498
msgid "The central directory is shorter than it says."
msgstr "Das zentrale Verzeichnis ist kürzer, als es angibt."

#: packages/store/src/zip-store.ts:490
msgid "The central directory is damaged."
msgstr "Das zentrale Verzeichnis ist beschädigt."

#: packages/store/src/zip-store.ts:503
msgid "{name} is encrypted."
msgstr "{name} ist verschlüsselt."

#: packages/store/src/zip-store.ts:505 packages/store/src/zip-store.ts:536
msgid "{name} is compressed; a case file is only ever stored."
msgstr ""
"{name} ist komprimiert; eine Falldatei wird nur gespeichert, nie komprimiert."

#: packages/store/src/zip-store.ts:507
msgid "{name} sits on another disk."
msgstr "{name} liegt auf einem anderen Datenträger."

#: packages/store/src/zip-store.ts:511
msgid "{name} is not a regular file."
msgstr "{name} ist keine reguläre Datei."

#: packages/store/src/zip-store.ts:521 packages/store/src/zip-store.ts:525
msgid "{name} lacks its ZIP64 sizes."
msgstr "{name} fehlen die ZIP64-Größen."

#: packages/store/src/zip-store.ts:539
msgid "The central directory has bytes no member accounts for."
msgstr "Das zentrale Verzeichnis enthält Bytes, die zu keiner Datei gehören."

#: packages/store/src/zip-store.ts:549
msgid "The local header of {name} is missing."
msgstr "Der lokale Kopf von {name} fehlt."

#: packages/store/src/zip-store.ts:556
msgid "The local header of {name} disagrees with the directory."
msgstr "Der lokale Kopf von {name} widerspricht dem Verzeichnis."

#: packages/store/src/zip-store.ts:561
msgid "{name} runs into the central directory."
msgstr "{name} reicht in das zentrale Verzeichnis hinein."

#: packages/store/src/zip-store.ts:593
msgid "A line of the manifest is far too long."
msgstr "Eine Zeile des Manifests ist viel zu lang."

