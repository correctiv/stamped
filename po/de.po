#: app/src/commands/keys.ts:406
msgid "The signing domain"
msgstr "Die signierende Domain"

#: app/src/commands/keys.ts:411
msgid "One or more selectors"
msgstr "Ein oder mehrere Selektoren"

#: app/src/commands/keys.ts:417
msgid "When the messages were sent, e.g. \"March 2019\""
msgstr "Wann die Nachrichten gesendet wurden, z. B. \"März 2019\""

#: app/src/commands/people.ts:27
msgid ""
"List the addresses of a case folder by how much mail they sent and received"
msgstr ""
"Die Adressen eines Fallordners nach gesendeten und empfangenen Mails "
"auflisten"

#: app/src/commands/people.ts:33
msgid "Only addresses or names containing this text"
msgstr "Nur Adressen oder Namen, die diesen Text enthalten"

#: app/src/commands/people.ts:36
