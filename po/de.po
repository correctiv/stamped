msgid "The archive comment is too long."
msgstr "Der Archivkommentar ist zu lang."

#: packages/store/src/zip-store.ts:387
msgid "an empty name"
msgstr "ein leerer Name"

#: packages/store/src/zip-store.ts:388
msgid "an absolute path"
msgstr "ein absoluter Pfad"

#: packages/store/src/zip-store.ts:389
msgid "a backslash in the path"
msgstr "ein Backslash im Pfad"

#: packages/store/src/zip-store.ts:390
msgid "a drive letter"
msgstr "ein Laufwerksbuchstabe"

