msgstr "(keine)"

#: app/src/lib/report.ts:61
msgid "author domain"
msgstr "Absenderdomain"

#: app/src/lib/report.ts:61
msgid "(unknown)"
msgstr "(unbekannt)"

#: app/src/lib/report.ts:62
msgid "aligned"
msgstr "übereinstimmend"

#: app/src/lib/report.ts:62
msgid "yes"
msgstr "ja"

#: app/src/lib/report.ts:62
msgid "no"
msgstr "nein"

#: app/src/lib/report.ts:63
msgid "selector"
msgstr "Selektor"

#: app/src/lib/report.ts:64
msgid "algorithm"
msgstr "Algorithmus"

#: app/src/lib/report.ts:65
msgid "canonicalization"
msgstr "Kanonisierung"

#: app/src/lib/report.ts:66
msgid "key"
msgstr "Schlüssel"

#: app/src/lib/report.ts:67
msgid "signed headers"
msgstr "sign. Kopfzeilen"

#: app/src/lib/report.ts:68
msgid "body hash"
msgstr "Body-Hash"

#: app/src/lib/report.ts:69
msgid "signature"
msgstr "Signatur"

#: app/src/lib/report.ts:69
msgid "verified"
msgstr "verifiziert"

#: app/src/lib/report.ts:69
msgid "not verified"
msgstr "nicht verifiziert"

#: app/src/lib/report.ts:73
msgid "l= limit"
msgstr "l=-Grenze"

#: app/src/lib/report.ts:76
msgid "reason"
msgstr "Grund"

#: app/src/lib/report.ts:81
msgid "verifier says"
msgstr "Prüfer meldet"

#: app/src/lib/report.ts:84
msgid "  caveat: {text}"
msgstr "  Einschränkung: {text}"

#: app/src/lib/report.ts:96
msgid "none fetched"
msgstr "keiner abgerufen"

#: app/src/lib/report.ts:102
