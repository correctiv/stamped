msgid "l= limit"
msgstr "l=-Grenze"

#: packages/core/src/explain.ts:110 packages/core/src/explain.ts:142
msgid "Retry"
msgstr "Wiederholung"

#: packages/core/src/explain.ts:113
msgid "undoing doubled leading dots makes the hash match"
msgstr "Doppelte führende Punkte zurückzunehmen lässt den Hash passen"

#: packages/core/src/explain.ts:115
msgid "converting line endings to CRLF makes the hash match"
msgstr "Zeilenenden nach CRLF umzuwandeln lässt den Hash passen"

#: packages/core/src/explain.ts:116
msgid ""
"undoing doubled leading dots and converting line endings makes the hash match"
msgstr ""
"Doppelte führende Punkte zurückzunehmen und Zeilenenden umzuwandeln lässt "
"den Hash passen"

#: packages/core/src/explain.ts:120
