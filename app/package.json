{
  "name": "stamped-cli",
  "version": "0.3.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Stamped app: the `stamped` binary — the GTK4/libadwaita window and the CLI over the @stamped/* packages, bundled to a single .gjs.mjs and run on GJS via gjsify.",
  "main": "src/gui/main.ts",
  "exports": {
    ".": "./src/gui/main.ts",
    "./cli": "./src/index.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit",
    "format": "gjsify format --write .",
    "format:check": "gjsify format --check .",
    "lint": "gjsify lint .",
    "lint:fix": "gjsify lint --fix .",
    "build": "gjsify run build:gjs",
    "build:gjs": "node scripts/build-bundle.mjs gjs",
    "build:node": "node scripts/build-bundle.mjs node",
    "start": "gjsify run dist/stamped.gjs.mjs",
    "dev": "gjsify run build:gjs && gjsify run start",
    "fixtures": "node ../tools/make-fixtures.mjs",
    "bench": "node ../tools/bench-gjs.mjs",
    "bench:stall": "gjsify build scripts/bench-stall.ts --app gjs --outfile dist/bench-stall.gjs.mjs && gjsify run dist/bench-stall.gjs.mjs",
    "test": "LC_ALL=C LANGUAGE= gjsify test",
    "test:embedder": "node --experimental-strip-types tests/embedder.integration.mts",
    "test:embedder:gjs": "gjsify build tests/embedder.integration.mts --app gjs -o dist/embedder.integration.gjs.mjs && gjsify run dist/embedder.integration.gjs.mjs",
    "check:macos-app": "node tests/macos/check-app.mjs"
  },
  "gjsify": {
    "ship": {
      "appId": "org.correctiv.Stamped",
      "binaryName": "stamped",
      "bundledTypelibs": {
        "linux": [
          "../node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64"
        ]
      },
      "kind": "app",
      "nodeModules": ["node-llama-cpp"],
      "nodeModulesExclude": [
        "@node-llama-cpp/win-x64-cuda",
        "@node-llama-cpp/win-x64-cuda-ext",
        "@node-llama-cpp/win-x64-vulkan"
      ],
      "name": "Stamped",
      "localeDir": "dist/locale",
      "bundle": {
        "linux": "dist/stamped.gjs.mjs",
        "darwin": "dist/stamped.node.mjs",
        "win32": "dist/stamped.node.mjs"
      },
      "app": {
        "darwin": "node",
        "win32": "node"
      },
      "developer": {
        "id": "org.correctiv",
        "name": "CORRECTIV",
        "email": "info@correctiv.org"
      },
      "summary": "Verify and explore emails",
      "license": {
        "project": "AGPL-3.0-or-later"
      },
      "description": "Stamped verifies the DKIM signatures of email messages and says what each signature actually covers: confirmed, confirmed with caveats, body altered, headers altered, unverifiable, or unsigned. It works offline — public keys come from a store you fill, so examining a leaked message sends no lookup to the signing domain.",
      "homepageUrl": "https://github.com/correctiv/stamped",
      "bugtrackerUrl": "https://github.com/correctiv/stamped/issues",
      "vcsBrowserUrl": "https://github.com/correctiv/stamped",
      "icon": "../data/icons/hicolor/scalable/apps/org.correctiv.Stamped.svg",
      "maintainer": "CORRECTIV <info@correctiv.org>",
      "categories": [
        "Office",
        "Email",
        "Security"
      ],
      "screenshots": [
        {
          "url": "https://raw.githubusercontent.com/correctiv/stamped/main/docs/images/01-message.png",
          "localizedUrls": {
            "de": "https://raw.githubusercontent.com/correctiv/stamped/main/docs/images/04-message-de.png"
          },
          "caption": "A message with its verdict and the evidence behind it",
          "environment": "gnome",
          "type": "default"
        },
        {
          "url": "https://raw.githubusercontent.com/correctiv/stamped/main/docs/images/02-keys.png",
          "caption": "Which public keys the archive still needs",
          "environment": "gnome"
        },
        {
          "url": "https://raw.githubusercontent.com/correctiv/stamped/main/docs/images/03-overview.png",
          "caption": "How the whole case breaks down by verdict",
          "environment": "gnome"
        }
      ]
    },
    "aliases": {
      "child_process": "@stamped/semantic/child-process",
      "node:child_process": "@stamped/semantic/child-process",
      "ipull": "ipull/node"
    },
    "excludeGlobals": [
      "document",
      "HTMLElement",
      "location",
      "Image",
      "HTMLCanvasElement",
      "HTMLImageElement",
      "FontFace",
      "matchMedia",
      "MutationObserver",
      "ResizeObserver",
      "IntersectionObserver"
    ],
    "test": {
      "entry": "tests/test.mts",
      "outdir": "dist",
      "runtimes": [
        "gjs",
        "node"
      ]
    }
  },
  "dependencies": {
    "@stamped/core": "*",
    "@stamped/import": "*",
    "@stamped/semantic": "*",
    "@stamped/store": "*",
    "@stamped/verify": "*",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@gjsify/cli": "0.64.11",
    "@gjsify/napi": "0.64.11",
    "@gjsify/node-globals": "0.64.11",
    "@gjsify/rolldown-native": "0.64.11",
    "@gjsify/runtime": "0.64.11",
    "@gjsify/sqlite": "0.64.11",
    "@gjsify/adwaita-app": "0.64.11",
    "@gjsify/unit": "0.64.11",
    "@girs/adw-1": "5.4.0",
    "@girs/gdk-4.0": "5.4.0",
    "@girs/gio-2.0": "5.4.0",
    "@girs/gjs": "5.4.0",
    "@girs/glib-2.0": "5.4.0",
    "@girs/gobject-2.0": "5.4.0",
    "@girs/graphene-1.0": "5.4.0",
    "@girs/gsk-4.0": "5.4.0",
    "@girs/gtk-4.0": "5.4.0",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3",
    "@gjsify/node-gi": "0.64.11"
  },
  "optionalDependencies": {
    "@gjsify/gtk-runtime-darwin-arm64": "0.64.11",
    "@gjsify/gtk-runtime-darwin-x64": "0.64.11",
    "@gjsify/gtk-runtime-win32-arm64": "0.64.11",
    "@gjsify/gtk-runtime-win32-x64": "0.64.11",
    "@gjsify/node-runtime-darwin-arm64": "0.64.11",
    "@gjsify/node-runtime-darwin-x64": "0.64.11",
    "@gjsify/node-runtime-win32-arm64": "0.64.11",
    "@gjsify/node-runtime-win32-x64": "0.64.11"
  }
}
