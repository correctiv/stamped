using Gtk 4.0;

// The ⓘ button and its popover. Entirely static: the only thing TypeScript sets is the label,
// which is one of the explanations the view models already produce.
//
// An INFO icon, never a question mark. A "?" is already the icon of the `unverifiable` verdict,
// so a "?" offering help next to a verdict badge reads as a verdict.
//
// `help-about-symbolic` is the ⓘ, and `dialog-information-symbolic` is NOT: in Adwaita it draws a
// lightbulb. Checked in a screenshot, not in the name.
template $StampedHelpButton: Gtk.MenuButton {
  icon-name: "help-about-symbolic";
  valign: center;

  styles [
    "flat",
    "circular",
  ]

  popover: Gtk.Popover {
    child: Gtk.Label text {
      xalign: 0;
      wrap: true;
      max-width-chars: 38;
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 12;
      margin-end: 12;
      use-markup: true;
    };
  };
}
